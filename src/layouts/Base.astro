---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
  // Widens the reading column. The quiz and About read at a newspaper
  // column; the archive and the admin are lists and forms and take more.
  bodyClass?: string;
}

const {
  title = 'Friday 13',
  description = 'A quiz of 13 questions across 3 categories and a final question, published on Friday mornings.',
  noIndex = false,
  bodyClass = undefined,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Self-hosted fonts, so the page makes no third-party request. Only the
        latin subsets are preloaded; latin-ext loads on demand. */}
    <link
      rel="preload"
      href="/fonts/bodoni-moda-500-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-serif-4-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/dm-mono-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:site_name" content="Friday 13" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={Astro.site ? new URL('/og-image.png', Astro.site).href : '/og-image.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <!--
      Cloudflare Web Analytics.
      Paste your real token in place of REPLACE_WITH_YOUR_TOKEN below.
      Find it in the Cloudflare dashboard under Analytics and then Web Analytics.
    -->
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "REPLACE_WITH_YOUR_TOKEN"}'></script>
  </body>
</html>
