---
// Analytics. Overview: completions and average per edition over time.
// Per-quiz view (?id=): completion count, average, per-question percentages.
import Base from '../../layouts/Base.astro';
---

<Base title="The Quizz, Analytics" noIndex={true} bodyClass="admin">
  <div id="admin-app"></div>
</Base>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { el, pad2 } from '../../lib/quiz-render.js';
  import {
    requireAdmin,
    adminNav,
    statusChip,
    fetchQuizById,
    formatSydney,
  } from '../../lib/admin.js';

  const root = document.getElementById('admin-app');

  function bar(value, max) {
    const pct = max > 0 ? Math.round((value / max) * 100) : 0;
    const fill = el('div', { class: 'bar' });
    fill.style.width = pct + '%';
    return el('div', { class: 'bar-track' }, [fill]);
  }

  // A figure and its bar. Real numbers or nothing: with no data the cell is
  // left empty rather than filled with a placeholder.
  function figure(value, max, suffix) {
    if (value == null) return el('td', {});
    return el('td', {}, [
      el('span', { class: 'stat-value mono', text: String(value) + (suffix || '') }),
      bar(value, max),
    ]);
  }

  async function renderOverview() {
    const [{ data: quizzes, error }, { data: stats }] = await Promise.all([
      supabase
        .from('quizzes')
        .select('id, edition_number, title, status, publish_at')
        .order('edition_number', { ascending: true }),
      supabase.rpc('get_archive_stats'),
    ]);
    if (error) {
      root.replaceChildren(
        adminNav('analytics'),
        el('p', { class: 'load-error', text: 'Could not load analytics.' })
      );
      return;
    }
    const statMap = new Map((stats || []).map((r) => [r.quiz_id, r]));
    const maxCompletions = Math.max(1, ...(stats || []).map((r) => Number(r.completion_count)));

    const rows = (quizzes || []).map((quiz) => {
      const s = statMap.get(quiz.id);
      const count = s ? Number(s.completion_count) : 0;
      const avg = s && s.avg_score != null ? s.avg_score : null;
      return el('tr', {}, [
        el('td', {}, [
          el('a', {
            class: 'stat-edition mono',
            href: '/admin/analytics?id=' + quiz.id,
            text: pad2(quiz.edition_number),
          }),
        ]),
        el('td', {}, [statusChip(quiz)]),
        figure(count, maxCompletions),
        figure(avg, 16),
      ]);
    });

    root.replaceChildren(
      adminNav('analytics'),
      el('div', { class: 'admin-head bleed' }, [el('h1', { text: 'Analytics' })]),
      el('table', { class: 'stat-table' }, [
        el('thead', {}, [
          el('tr', {}, [
            el('th', { scope: 'col', text: 'No.' }),
            el('th', { scope: 'col', text: 'Status' }),
            el('th', { scope: 'col', text: 'Completions' }),
            el('th', { scope: 'col', text: 'Average' }),
          ]),
        ]),
        el('tbody', {}, rows),
      ]),
      el('p', { class: 'admin-note mono', text: 'All times Melbourne' })
    );
  }

  async function renderQuiz(id) {
    const [quiz, { data: quizStats }, { data: questionStats }] = await Promise.all([
      fetchQuizById(id),
      supabase.rpc('get_quiz_stats', { p_quiz_id: id }),
      supabase.rpc('get_question_stats', { p_quiz_id: id }),
    ]);
    if (!quiz) {
      root.replaceChildren(
        adminNav('analytics'),
        el('p', { class: 'load-error', text: 'Quiz not found.' })
      );
      return;
    }
    const stats = Array.isArray(quizStats) ? quizStats[0] : quizStats;
    const count = stats ? Number(stats.completion_count) : 0;
    const avg = stats && stats.avg_score != null ? stats.avg_score : null;
    const statMap = new Map((questionStats || []).map((r) => [r.question_id, r]));
    const questions = [...quiz.questions].sort((a, b) => a.sort_order - b.sort_order);

    const rows = questions.map((q) => {
      const s = statMap.get(q.id);
      const responses = s ? Number(s.response_count) : 0;
      const pct = s && s.pct_correct != null ? Number(s.pct_correct) : null;
      return el('tr', {}, [
        el('td', {}, [el('span', { class: 'stat-number mono', text: pad2(q.sort_order) })]),
        el('td', { class: 'stat-question', text: q.question_text }),
        pct != null
          ? figure(pct, 100, '%')
          : el('td', {}, [
              el('span', {
                class: 'stat-value mono muted',
                text: responses === 1 ? '1 response' : responses + ' responses',
              }),
            ]),
      ]);
    });

    // The figures that stand on their own, before the per-question detail.
    const summary = el('div', { class: 'stat-summary' }, [
      el('div', { class: 'stat-cell' }, [
        el('p', { class: 'label muted', text: 'Completions' }),
        el('p', { class: 'stat-cell-value numeral', text: String(count) }),
      ]),
    ]);
    if (avg != null) {
      summary.appendChild(
        el('div', { class: 'stat-cell' }, [
          el('p', { class: 'label muted', text: 'Average' }),
          el('p', { class: 'stat-cell-value numeral', text: String(avg) }),
        ])
      );
    }

    root.replaceChildren(
      adminNav('analytics'),
      el('div', { class: 'admin-head bleed' }, [
        el('h1', { text: 'Edition ' + pad2(quiz.edition_number) }),
        statusChip(quiz),
      ]),
      el('p', { class: 'admin-note mono', text: formatSydney(quiz.publish_at) }),
      summary,
      el('h2', { class: 'label muted stat-heading', text: 'Correct answers per question' }),
      el('table', { class: 'stat-table' }, [el('tbody', {}, rows)]),
      el('p', { class: 'admin-note mono' }, [
        el('a', { href: '/admin/analytics', text: 'All editions' }),
      ])
    );
  }

  (async () => {
    if (!root) return;
    const session = await requireAdmin(root);
    if (!session) return;
    const id = new URLSearchParams(location.search).get('id');
    try {
      if (id) await renderQuiz(id);
      else await renderOverview();
    } catch (err) {
      console.error('[quizz admin]', err);
      root.replaceChildren(
        adminNav('analytics'),
        el('p', { class: 'load-error', text: 'Could not load analytics.' })
      );
    }
  })();
</script>
