---
// Admin dashboard: quiz list and the New quiz button.
import Base from '../../layouts/Base.astro';
---

<Base title="The Quizz, Admin" noIndex={true} bodyClass="admin">
  <div id="admin-app"></div>
</Base>

<script>
  import { supabase } from '../../lib/supabase.js';
  import { el, pad2 } from '../../lib/quiz-render.js';
  import {
    requireAdmin,
    adminNav,
    statusChip,
    nextSaturdaySydney6am,
    formatSydney,
  } from '../../lib/admin.js';

  const root = document.getElementById('admin-app');

  async function createQuiz(quizzes, button, errorLine) {
    button.disabled = true;
    errorLine.classList.add('hidden');
    try {
      const maxEdition = quizzes.reduce((max, q) => Math.max(max, q.edition_number), 0);
      const publishAt = nextSaturdaySydney6am();
      const { data: quiz, error } = await supabase
        .from('quizzes')
        .insert({
          edition_number: maxEdition + 1,
          publish_at: publishAt.toISOString(),
          status: 'draft',
        })
        .select('id')
        .single();
      if (error) throw error;

      const { data: cats, error: catError } = await supabase
        .from('categories')
        .insert([1, 2, 3, 4].map((i) => ({ quiz_id: quiz.id, name: '', sort_order: i })))
        .select('id, sort_order');
      if (catError) throw catError;

      const sortedCats = [...cats].sort((a, b) => a.sort_order - b.sort_order);
      const questionRows = [];
      for (let i = 0; i < 16; i++) {
        questionRows.push({
          quiz_id: quiz.id,
          category_id: sortedCats[Math.floor(i / 4)].id,
          sort_order: i + 1,
          question_text: '',
          answer_text: '',
        });
      }
      const { error: qError } = await supabase.from('questions').insert(questionRows);
      if (qError) throw qError;

      location.href = '/admin/edit?id=' + quiz.id;
    } catch (err) {
      console.error('[quizz admin]', err);
      errorLine.textContent = 'Could not create the quiz: ' + (err.message || 'unknown error');
      errorLine.classList.remove('hidden');
      button.disabled = false;
    }
  }

  function actionLink(href, text) {
    return el('a', { class: 'btn btn-small', href, text });
  }

  function buildRow(quiz, isLast) {
    // A title is optional on most editions. Without one the row is named by
    // its number alone, and the title cell says so quietly.
    const titled = Boolean(quiz.title);
    return el('div', { class: 'admin-row' + (isLast ? ' is-last' : '') }, [
      el('span', { class: 'admin-row-number mono', text: pad2(quiz.edition_number) }),
      el('h2', { class: 'admin-row-title' + (titled ? '' : ' is-untitled') }, [
        el('a', {
          href: '/admin/edit?id=' + quiz.id,
          text: titled ? quiz.title : 'Untitled',
        }),
      ]),
      statusChip(quiz),
      el('p', { class: 'admin-row-date mono', text: formatSydney(quiz.publish_at) }),
      el('div', { class: 'admin-row-actions' }, [
        actionLink('/admin/edit?id=' + quiz.id, 'Edit'),
        actionLink('/admin/preview?id=' + quiz.id, 'Preview'),
        actionLink('/admin/analytics?id=' + quiz.id, 'Analytics'),
      ]),
    ]);
  }

  function buildEmpty(onCreate) {
    const write = el('button', { type: 'button', class: 'btn-primary', text: 'Write edition 01' });
    write.addEventListener('click', onCreate);
    return el('div', { class: 'admin-empty bleed' }, [
      el('p', { class: 'label muted', text: 'No quizzes yet' }),
      el('p', {
        class: 'admin-empty-text',
        text:
          'Nothing has been written yet. The first edition will be No. 01, and it publishes ' +
          'the Saturday morning after it is scheduled.',
      }),
      write,
    ]);
  }

  async function renderDashboard() {
    const { data: quizzes, error } = await supabase
      .from('quizzes')
      .select('id, edition_number, title, status, publish_at')
      .order('edition_number', { ascending: false });
    if (error) {
      root.replaceChildren(adminNav('dashboard'), el('p', { class: 'load-error', text: 'Could not load quizzes.' }));
      return;
    }

    const newBtn = el('button', { type: 'button', class: 'btn-primary', text: 'New quiz' });
    const errorLine = el('p', { class: 'mono form-error hidden', role: 'alert' });
    const create = () => createQuiz(quizzes, newBtn, errorLine);
    newBtn.addEventListener('click', create);

    const parts = [
      adminNav('dashboard'),
      el('div', { class: 'admin-head' }, [el('h1', { text: 'Quizzes' }), newBtn]),
      errorLine,
    ];

    if (quizzes.length > 0) {
      parts.push(
        el('div', { class: 'admin-table-head mono bleed' }, [
          el('span', { text: 'No.' }),
          el('span', { text: 'Title' }),
          el('span', { text: 'Status' }),
        ]),
        ...quizzes.map((quiz, index) => buildRow(quiz, index === quizzes.length - 1))
      );
    } else {
      parts.push(buildEmpty(create));
    }

    // Each row carries its own AEST or AEDT, so this names the place rather
    // than an offset that could not be right for every row in the list.
    parts.push(el('p', { class: 'admin-note mono', text: 'All times Melbourne' }));

    root.replaceChildren(...parts);
  }

  (async () => {
    if (!root) return;
    const session = await requireAdmin(root);
    if (session) await renderDashboard();
  })();
</script>
