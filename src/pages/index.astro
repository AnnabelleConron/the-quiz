---
// Home: the front page. The current week's edition, what is behind it in
// the archive, and what the paper is. The quiz itself lives at its own
// permalink; this page points at it.
import Base from '../layouts/Base.astro';
import SiteTop from '../components/SiteTop.astro';
---

<Base>
  <SiteTop current="home" />
  <main id="home-app">
    <noscript>
      <p>Friday 13 needs JavaScript to load this week's edition.</p>
    </noscript>
  </main>
</Base>

<script>
  import {
    fetchLatestQuiz,
    formatDateline,
    pad2,
    el,
    TOTAL_QUESTIONS,
    FINAL_QUESTION,
    isFinalCategory,
  } from '../lib/quiz-render.js';
  import { loadProgress } from '../lib/session.js';

  const root = document.getElementById('home-app');

  function masthead() {
    return el('div', { class: 'masthead masthead-home' }, [
      el('h1', { class: 'masthead-title', text: 'Friday 13' }),
    ]);
  }

  function dateline(quiz) {
    const parts = formatDateline(quiz.publish_at);
    return el('div', { class: 'dateline mono bleed' }, [
      el('span', { text: 'No. ' + pad2(quiz.edition_number) }),
      el('span', { class: 'dateline-date', text: parts.date }),
      el('span', { text: parts.weekday }),
    ]);
  }

  // This week's edition: the three category names and the final question's
  // at the scale they are met at, and one way in.
  function editionSection(quiz, categories, completed) {
    const section = el('section', { class: 'edition bleed' }, [
      el('div', { class: 'edition-head' }, [
        el('p', { class: 'label label-accent', text: "This week's edition" }),
        el('p', { class: 'label muted', text: TOTAL_QUESTIONS + ' questions' }),
      ]),
      el(
        'ol',
        { class: 'contents-list' },
        categories.map((category, index) =>
          el('li', { class: 'contents-row' }, [
            el('span', {
              class: 'contents-num mono',
              text: isFinalCategory(index, categories) ? pad2(FINAL_QUESTION) : pad2(index + 1),
            }),
            el('h2', { class: 'contents-name', text: category.name }),
          ])
        )
      ),
    ]);

    const href = '/quiz/' + quiz.edition_number;

    if (completed) {
      // Played on this device. The score, and a quieter way back in.
      section.appendChild(
        el('div', { class: 'edition-played' }, [
          el('p', { class: 'label muted', text: 'You played this edition' }),
          el('p', { class: 'score-figure' }, [
            el('span', { class: 'score-number numeral', text: pad2(completed.score) }),
            el('span', { class: 'score-total numeral', text: '/' + TOTAL_QUESTIONS }),
          ]),
          el('a', { class: 'btn', href, text: 'Review your answers' }),
        ])
      );
    } else {
      section.appendChild(
        el('div', { class: 'edition-cta' }, [
          el('a', {
            class: 'btn btn-primary btn-block',
            href,
            text: "Start this week's quiz",
          }),
        ])
      );
    }

    return section;
  }

  function pitch(label, title, href, action, modifier) {
    return el('section', { class: 'pitch ' + modifier }, [
      el('p', { class: 'label muted', text: label }),
      el('h2', { class: 'pitch-title', text: title }),
      el('a', { class: 'btn', href, text: action }),
    ]);
  }

  (async () => {
    if (!root) return;
    root.textContent = 'Loading this week.';
    try {
      const quiz = await fetchLatestQuiz();

      if (!quiz) {
        root.replaceChildren(
          masthead(),
          el('section', { class: 'pitch pitch-last' }, [
            el('h2', { class: 'pitch-title', text: 'The first edition is on its way' }),
            el('p', {
              class: 'pitch-text',
              text: 'Quizzes are published on Friday mornings.',
            }),
          ])
        );
        return;
      }

      const categories = [...(quiz.categories || [])].sort((a, b) => a.sort_order - b.sort_order);
      const completed = loadProgress(quiz.id).completed;

      root.replaceChildren(
        masthead(),
        dateline(quiz),
        editionSection(quiz, categories, completed),
        pitch('Past quizzes', 'Past quiz editions', '/archive', 'Visit the archives', ''),
        pitch('About', 'A quiz for Friday mornings', '/about', 'Find out more', 'pitch-last bleed')
      );
    } catch (err) {
      console.error('[friday13]', err);
      root.replaceChildren(
        masthead(),
        el('p', { class: 'load-error', text: 'Something went wrong. Refresh to try again.' })
      );
    }
  })();
</script>
