---
// About: one page, one paragraph. Nothing here depends on the database,
// so it is served as static HTML and makes no request at all.
import Base from '../layouts/Base.astro';
import SiteTop from '../components/SiteTop.astro';

const description =
  'The Quizz is written by hand and published on Saturday mornings. Four categories, sixteen questions.';
---

<Base title="The Quizz, About" description={description}>
  <SiteTop current="about" />
  <main>
    <div class="masthead masthead-about bleed">
      <h1 class="masthead-title">About</h1>
    </div>

    <section class="about">
      <h2 class="about-title">A quiz for Saturday mornings</h2>
      <p class="about-text">
        The Quizz is published on Saturday mornings. Four categories,
        sixteen questions.
      </p>
    </section>

    <footer class="site-footer">
      <p class="label muted">New quizzes on Saturday mornings</p>
    </footer>
  </main>
</Base>
