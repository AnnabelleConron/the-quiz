---
// About: one page, one paragraph. Nothing here depends on the database,
// so it is served as static HTML and makes no request at all.
import Base from '../layouts/Base.astro';
import SiteTop from '../components/SiteTop.astro';

const description =
  'Friday 13 is written by hand and published on Friday mornings. Three categories and a final question, thirteen questions.';
---

<Base title="Friday 13, About" description={description}>
  <SiteTop current="about" />
  <main>
    <div class="masthead masthead-about bleed">
      <h1 class="masthead-title">About</h1>
    </div>

    <section class="about">
      <h2 class="about-title">A quiz for Friday mornings</h2>
      <p class="about-text">
        Friday 13 is published on Friday mornings. Three categories and a
        final question, thirteen questions.
      </p>
    </section>

    <footer class="site-footer">
      <p class="label muted">New quizzes on Friday mornings</p>
    </footer>
  </main>
</Base>
