# Copy this file to .env and fill in the values from your Supabase project.
# Dashboard: Settings, then API.
# Only the project URL and the publishable (anon) key belong here.
# Never put the secret key (sb_secret_...) in this file or anywhere in the repo.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here
